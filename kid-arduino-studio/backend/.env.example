# Kid Arduino Studio - Çevre Değişkenleri

# Yerel Ollama API Adresi (Varsayılan: http://127.0.0.1:11434)
OLLAMA_API_BASE=http://127.0.0.1:11434

# Bulut LLM Sağlayıcıları (İsteğe bağlı - yerel Ollama ile anahtarsız da çalışır)
# Bu dosyayı .env adıyla kopyalayıp anahtarları orada doldurun; .env git'e girmez.
# Gerçek anahtarları ASLA bu .env.example dosyasına yazmayın.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Varsayılan Model (örn: ollama/qwen2.5-coder:1.5b veya gemini/gemini-2.5-flash)
LLM_MODEL=ollama/qwen2.5-coder:1.5b

# Arduino CLI çalıştırılabilir dosya yolu
ARDUINO_CLI_PATH=arduino-cli

# Sunucu Portu (frontend /api isteklerini 8001'e yönlendirir; uvicorn'u --port 8001 ile başlatın)
PORT=8001
