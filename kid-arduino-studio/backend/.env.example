# Kid Arduino Studio - Çevre Değişkenleri

# Yerel Ollama API Adresi (Varsayılan: http://127.0.0.1:11434)
OLLAMA_API_BASE=http://127.0.0.1:11434

# Bulut LLM Sağlayıcıları (İsteğe bağlı - yerel Ollama veya hazır demolarla anahtarsız da çalışır)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Varsayılan Model (örn: ollama/qwen2.5-coder:1.5b veya gemini/gemini-2.0-flash)
LLM_MODEL=ollama/qwen2.5-coder:1.5b

# Arduino CLI çalıştırılabilir dosya yolu
ARDUINO_CLI_PATH=arduino-cli

# Sunucu Portu
PORT=8000
