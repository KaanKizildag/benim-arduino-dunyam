# Kid Arduino Studio - Çevre Değişkenleri

# LLM Sağlayıcısı ve API Anahtarı (Gemini veya OpenAI)
# Not: API anahtarı olmadan da sistem 2 adet zengin dahili Demo Proje ile tam çalışır!
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LiteLLM Model Belirteci (örn: gemini/gemini-1.5-flash, openai/gpt-4o-mini, ollama/llama3)
LLM_MODEL=gemini/gemini-1.5-flash

# Arduino CLI çalıştırılabilir dosya yolu (Varsayılan: arduino-cli)
ARDUINO_CLI_PATH=arduino-cli

# Sunucu Portu
PORT=8000
